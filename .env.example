# ─────────────────────────────────────────────────────────────────────────────
# Пример переменных окружения для API-сервера «Барометр».
# Скопируй в .env.local и заполни реальными значениями (.env.local в .gitignore).
# НИКОГДА не коммить .env.local с реальными секретами.
# Читается сервером scripts/api-server.ts (в dev и под PM2 в production).
# ─────────────────────────────────────────────────────────────────────────────

# ── Авторизация (обязательно) ────────────────────────────────────────────────
# Логин/пароль проверяются ТОЛЬКО на сервере (эндпоинт /api/auth).
APP_LOGIN=your-login
APP_PASSWORD=your-password
# Секрет для HMAC-SHA256 подписи сессионных токенов (signToken/verifyToken).
# Длинная случайная строка. При смене — все выданные токены инвалидируются.
APP_SESSION_SECRET=change-me-to-a-long-random-string

# ── Модель (обязательно для ИИ-ассистента) ───────────────────────────────────
# Адрес OpenAI-совместимого API. ВАЖНО: указывать ВМЕСТЕ с /v1, но БЕЗ
# /chat/completions — суффикс добавляет клиент. Неверный адрес даёт 404.
# Пример для vLLM: http://llm-host:8000/v1
AI_BASE_URL=http://localhost:8000/v1
# Имя модели ровно так, как она зарегистрирована на сервере инференса
# (для vLLM — значение --served-model-name или путь к весам).
AI_MODEL=qwen3-32b
# Ключ API. Локальный vLLM обычно поднимают без авторизации — тогда оставить пустым.
AI_API_KEY=

# ── Поведение модели (опционально) ───────────────────────────────────────────
# Поддерживает ли модель распознавание изображений (VL-версии Qwen).
# false — вложенные картинки заменяются текстовой пометкой, чтобы запрос не падал.
# Включать ТОЛЬКО если модель мультимодальная, иначе сервер ответит 400.
AI_VISION=false
# Потоковая отдача ответа (печать по буквам). Выключить, если tool-парсер vLLM
# некорректно работает в стриминге: ответ придёт целиком, остальное продолжит работать.
AI_STREAM=true
# Режим размышлений Qwen (chat_template_kwargs.enable_thinking).
# Выключен по умолчанию: заметно увеличивает время ответа и занимает слоты инференса.
AI_ENABLE_THINKING=false

# ── Веб-поиск Brave (опционально) ────────────────────────────────────────────
# Ключ Brave Search API (эндпоинт /api/search, инструмент search_web).
# Без него поиск возвращает пустой результат с пояснением (не падает).
BRAVE_SEARCH_API_KEY=your-brave-search-api-key
# Опционально: базовый URL прокси для Brave (суффикс /brave).
# Если не задан — используется https://api.search.brave.com напрямую.
BRAVE_PROXY_URL=https://your-proxy.example.workers.dev/brave

# ── Прокси (опционально) ─────────────────────────────────────────────────────
# Секрет для доступа к прокси (заголовок x-proxy-secret).
# Нужен, только если BRAVE_PROXY_URL указывает на защищённый прокси.
PROXY_SECRET=your-proxy-secret

# ── Прочее (опционально) ─────────────────────────────────────────────────────
# Порт API-сервера. По умолчанию 3001, `npm start` использует 3002.
PORT=3001
